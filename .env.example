# Local development. Docker Compose sets these itself (see docker-compose.yml).
APP_NAME="The Pocket Mechanic"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=tpms
DB_USERNAME=tpms
DB_PASSWORD=tpms

SESSION_DRIVER=database
SESSION_LIFETIME=43200
CACHE_STORE=database
QUEUE_CONNECTION=database
